# Конфигурация браузера
YANDEX_PATH=C:\Program Files\Yandex\YandexBrowser\Application\browser.exe
HEADLESS=false

# Конфигурация парсинга
TARGET_URL=https://example.com/private
DAYS_BACK=15
MAX_RECORDS=999999

# Конфигурация распознавания
CONFIDENCE_THRESHOLD=0.5
RECOGNITION_TIMEOUT=10

# Конфигурация экспорта
OUTPUT_DIR=output